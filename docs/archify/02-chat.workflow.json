      "role": "error",
      "variant": "security"
    },
    {
      "id": "quota-stop",
      "from": "chat-quota",
      "to": "chat-quota-fail",
      "label": "超额或不可用",
      "role": "error",
      "variant": "security",
      "route": "straight",
      "labelAt": [
        527.9,
        350
      ]
    },
    {
      "id": "forward-stop",
      "from": "chat-forward",
      "to": "chat-upstream-fail",
      "label": "无可结算用量的失败",
      "role": "error",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "接入与转发",
      "items": [
        "入口为 /v1/chat/completions；模型列表按令牌授权过滤。",
        "SSE 强制 include_usage；非流式先解析完整 JSON。"
      ]
    },
    {
      "dot": "amber",
      "title": "结算边界",
      "items": [
        "金额检查 used > limit；调用前未预占预算。",
        "缺失 usage 不伪造费用；流式异常已有 usage 时仍尝试结算。"
      ]
    },
    {
      "dot": "emerald",
      "title": "取消语义",
      "items": [
        "客户端断连后继续 drain，后续生命周期见独立状态图。",
        "Redis 累加与 MySQL 持久化分步执行。"
      ]
    }
  ]
}
