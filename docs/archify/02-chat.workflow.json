    {
      "id": "permission-quota",
      "from": "chat-permission",
      "to": "chat-quota",
      "label": "授权通过",
      "role": "main"
    },
    {
      "id": "quota-prepare",
      "from": "chat-quota",
      "to": "chat-prepare",
      "label": "额度通过",
      "role": "main"
    },
    {
      "id": "prepare-forward",
      "from": "chat-prepare",
      "to": "chat-forward",
      "label": "ProxyApi",
      "role": "main"
    },
    {
      "id": "forward-settle",
      "from": "chat-forward",
      "to": "chat-settle",
      "label": "有效 usage",
      "role": "main"
    },
    {
      "id": "permission-stop",
      "from": "chat-permission",
      "to": "chat-forbidden",
